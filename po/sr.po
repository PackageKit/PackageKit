#. TRANSLATORS: this is a percentage value we use in messages, e.g. "90%"
#: client/pk-offline-update.c:165
#, c-format
msgid "%i%%"
msgstr "%i%%"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing system upgrades
#: client/pk-offline-update.c:171
msgid "Installing System Upgrade"
msgstr "Инсталирам надоградњу система"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing updates
#: client/pk-offline-update.c:175
msgid "Installing Updates"
msgstr "Инсталирам ажурирања"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:206
msgid "Rebooting after installing updates…"
msgstr "Поново подижем систем након инсталирања ажурирања…"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:245
msgid "Shutting down after installing updates…"
msgstr "Искључујем систем након инсталирања ажурирања…"

#. TRANSLATORS: we've started doing offline updates
#: client/pk-offline-update.c:391
msgid "Installing updates; this could take a while..."
msgstr "Инсталирам ажурирања; ово може мало да потраје..."

#. TRANSLATORS: we've started doing offline system upgrade
#: client/pk-offline-update.c:429
msgid "Installing system upgrade; this could take a while..."
msgstr "Инсталирам надоградњу система; ово може мало да потраје..."

#. TRANSLATORS: This is when the daemon crashed, and we are up
#. * shit creek without a paddle
#: client/pkgc-context.c:130
msgid "The daemon crashed mid-transaction!"
msgstr "Услужни програм се изненада прекинуо!"

#. TRANSLATORS: command line argument, do we just download or apply changes
#: client/pkgc-manage.c:43
msgid "Prepare the transaction by downloading packages only"
msgstr "Припрема извршење само преузимајући пакете"

#. TRANSLATORS: command line argument, do we allow package downgrades
#: client/pkgc-manage.c:50
msgid "Allow package downgrades"
msgstr "Дозволи враћање пакета на претходна издања"

#. TRANSLATORS: command line argument, do we allow package re-installations
#: client/pkgc-manage.c:57
msgid "Allow package re-installations"
msgstr "Дозволи поновно инсталирање пакета"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:64
msgid "Allow installation of untrusted packages"
msgstr "Дозволи инсталирање неповерљивих пакета"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:71
msgid "Do not automatically remove unused dependencies"
msgstr "Немој аутоматски уклањати некоришћене зависности"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:78
msgid "Maximum metadata cache age in seconds (default: 3 days)"
msgstr "Највећа старост кеша метаподатака у секундама (подразумевано: 3 дана)"

#: client/pkgc-manage.c:78
msgid "SECONDS"
msgstr "СЕКУНДЕ"

#. TRANSLATORS: Description for pkgcli refresh
#: client/pkgc-manage.c:203
msgid "Refresh the package metadata cache."
msgstr "Освежи кеш метаподатака пакета."

#: client/pkgc-manage.c:229
msgid "Package metadata refreshed"
msgstr "Метаподаци пакета су освежени"

#. TRANSLATORS: Description for pkgcli install
#: client/pkgc-manage.c:254
msgid "Install one or more packages or local package files."
msgstr "Инсталирај један или више пакета или локалних датотека пакета."

#. TRANSLATORS: There was an error finding a package
#. * for installation. The detailed error follows.
#. TRANSLATORS: We were unable to find a package for installation.
#: client/pkgc-manage.c:316 client/pkgc-manage.c:330
#, c-format
msgid "Could not find any available package: %s"
msgstr "Нисам успео да пронађем ниједан доступан пакет: %s"

#: client/pkgc-manage.c:335
msgid "The selected package is already installed."
msgstr "Изабрани пакет је већ инсталиран."

#. TRANSLATORS: Description for pkgcli remove
#: client/pkgc-manage.c:376
msgid "Remove one or more packages from the system."
msgstr "Уклони један или више пакета са система."

#: client/pkgc-manage.c:393
#, c-format
msgid "Could not find installed packages: %s"
msgstr "Нисам успео да пронађем инсталиране пакете: %s"

#. TRANSLATORS: Description for pkgcli download
#: client/pkgc-manage.c:435
msgid "Download packages to the specified directory without installing."
msgstr "Преузми пакете у наведени директоријум без инсталирања."

#. TRANSLATORS: There was an error getting the
#. * details about the package. The detailed error follows
#: client/pkgc-manage.c:448 client/pkgc-query.c:439 client/pkgc-query.c:786
#, c-format
msgid "Could not find packages: %s"
msgstr "Нисам успео да пронађем пакете: %s"

#: client/pkgc-manage.c:456
#, c-format
msgid "Directory does not exist: %s"
msgstr "Директоријум не постоји: %s"

#. TRANSLATORS: Description for pkgcli update
#: client/pkgc-manage.c:500
msgid "Update all packages or specific packages to their latest versions."
msgstr "Ажурирај све пакете или одређене пакете на њихова најновија издања."

#: client/pkgc-manage.c:522
#, c-format
msgid "Could not find packages to update: %s"
msgstr "Нисам успео да пронађем пакете за ажурирање: %s"

#: client/pkgc-manage.c:552 client/pkgc-manage.c:653 client/pkgc-manage.c:885
#, c-format
msgid "Failed to get updates: %s"
msgstr "Нисам успео да добавим ажурирања: %s"

#: client/pkgc-manage.c:564 client/pkgc-manage.c:664 client/pkgc-manage.c:893
msgid "No packages require updating"
msgstr "Ниједан пакет не захтева ажурирање"

#. TRANSLATORS: Description of pkgcli upgrade.
#. * No not translate "minimal, default, complete", those are parameters
#: client/pkgc-manage.c:604
msgid ""
"Upgrade all packages or perform a distribution upgrade.\n"
"\n"
"Types: minimal, default, complete"
msgstr ""
"Надоградите све пакете или извршите надоградњу дистрибуције.\n"
"\n"
"Врсте: minimal, default, complete"

#: client/pkgc-manage.c:701
#, c-format
msgid "Failed to read offline update action: %s"
msgstr "Нисам успео да прочитам радњу ажурирања ван мреже: %s"

#: client/pkgc-manage.c:711
msgid "Offline update is not triggered."
msgstr "Ажурирање ван мреже није покренуто."

#: client/pkgc-manage.c:720
#, c-format
msgid "Offline update is triggered. Action after update: %s"
msgstr "Ажурирање ван мреже је покренуто. Радња након ажурирања: %s"

#. TRANSLATORS: Packages that were prepared for an offline update
#: client/pkgc-manage.c:731
msgid "Prepared packages:"
msgstr "Припремљени пакети:"

#: client/pkgc-manage.c:745
msgid "No offline update is prepared."
msgstr "Ниједно ажурирање ван мреже није припремљено."

#: client/pkgc-manage.c:748
#, c-format
msgid "Failed to read prepared offline updates: %s"
msgstr "Нисам успео да прочитам припремљена ажурирања ван мреже: %s"

#: client/pkgc-manage.c:759
msgid "No results from last offline update available."
msgstr "Нису доступни резултати последњег ажурирања ван мреже."

#: client/pkgc-manage.c:766
#, c-format
msgid "Last offline update failed: %s: %s"
msgstr "Последње ажурирање ван мреже није успело: %s: %s"

#: client/pkgc-manage.c:773
msgid "Last offline update completed successfully"
msgstr "Последње ажурирање ван мреже је успешно завршено"

#: client/pkgc-manage.c:783
#, c-format
msgid "Updated: %s"
msgstr "Ажурирано: %s"

#: client/pkgc-manage.c:807
#, c-format
msgid "Failed to trigger offline update: %s"
msgstr "Нисам успео да покренем ажурирање ван мреже: %s"

#: client/pkgc-manage.c:811
msgid "Offline update scheduled. System will update on next reboot."
msgstr "Ажурирање ван мреже је заказано. Систем ће се ажурирати приликом следећег поновног покретања."

#. TRANSLATORS: Description of the pkgcli offline-update command.
#. * The request values (trigger, prepare, etc.) are parameters and MUST NOT be translated.
#: client/pkgc-manage.c:831
msgid ""
"Trigger & manage offline system updates.\n"
"\n"
"You can select one of these requests:\n"
"  prepare - prepare an offline update and trigger it (default)\n"
"  trigger - trigger a (manually prepared) offline update\n"
"  cancel  - cancel a planned offline update\n"
"  status  - show status information about a prepared or finished offline update"
msgstr ""
"Покрените и управљајте ажурирањима система ван мреже.\n"
"\n"
"Можете изабрати један од ових захтева:\n"
"  prepare — припрема ажурирање ван мреже и покреће га (подразумевано)\n"
"  trigger — покреће (ручно припремљено) ажурирање ван мреже\n"
"  cancel  — отказује планирано ажурирање ван мреже\n"
"  status  — приказује податке о стању припремљеног или завршеног ажурирања ван мреже"

#: client/pkgc-manage.c:853
#, c-format
msgid "Failed to cancel offline update: %s"
msgstr "Нисам успео да откажем ажурирање ван мреже: %s"

#: client/pkgc-manage.c:857
msgid "Offline update cancelled"
msgstr "Ажурирање ван мреже је отказано"

#: client/pkgc-manage.c:914
#, c-format
msgid "Unknown offline-update request: %s"
msgstr "Непознат захтев за ажурирање ван мреже: %s"

