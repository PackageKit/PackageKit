#. TRANSLATORS: this is a percentage value we use in messages, e.g. "90%"
#: client/pk-offline-update.c:166
#, c-format
msgid "%i%%"
msgstr "%i%%"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing OS upgrades
#: client/pk-offline-update.c:172
msgid "Installing System Upgrade"
msgstr "Установка обновления системы"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing updates
#: client/pk-offline-update.c:176
msgid "Installing Updates"
msgstr "Установка обновлений"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:207
msgid "Rebooting after installing updates…"
msgstr "Перезагрузка после установки обновлений…"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:246
msgid "Shutting down after installing updates…"
msgstr "Выключение после установки обновлений…"

#. TRANSLATORS: we've started doing offline updates
#: client/pk-offline-update.c:392
msgid "Installing updates; this could take a while..."
msgstr "Установка обновлений. Это может занять некоторое время…"

#. TRANSLATORS: we've started doing an offline OS upgrade
#: client/pk-offline-update.c:430
msgid "Installing operating system upgrade; this could take a while..."
msgstr "Установка обновления операционной системы; это может занять некоторое время…"

#. TRANSLATORS: This is when the daemon crashed, and we are up
#. * shit creek without a paddle
#: client/pkgc-context.c:130
msgid "The daemon crashed mid-transaction!"
msgstr "Служба аварийно завершилась во время выполнения транзакции!"

#. TRANSLATORS: command line argument, do we just download or apply changes
#: client/pkgc-manage.c:44
msgid "Prepare the transaction by downloading packages only"
msgstr "Выполнить транзакцию, только загрузив пакеты"

#. TRANSLATORS: command line argument, do we allow package downgrades
#: client/pkgc-manage.c:51
msgid "Allow package downgrades"
msgstr "Разрешить понижение версий пакетов"

#. TRANSLATORS: command line argument, do we allow package re-installations
#: client/pkgc-manage.c:58
msgid "Allow package re-installations"
msgstr "Разрешить переустановку пакетов"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:65
msgid "Allow installation of untrusted packages"
msgstr "Разрешить установку недоверенных пакетов"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:72
msgid "Do not automatically remove unused dependencies"
msgstr "Не удалять автоматически неиспользуемые зависимости"

#. TRANSLATORS: command line argument, remove configuration files too
#: client/pkgc-manage.c:79
msgid "Also remove residual data (config files, databases, etc.) when removing packages"
msgstr "Также удалять остаточные данные (файлы конфигурации, базы данных и т. п.) при удалении пакетов"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:86
msgid "Maximum metadata cache age in seconds (default: 3 days)"
msgstr "Максимальный возраст кэша метаданных в секундах (по умолчанию: 3 дня)"

#: client/pkgc-manage.c:86
msgid "SECONDS"
msgstr "СЕКУНДЫ"

#: client/pkgc-manage.c:156
msgid "A system restart is required to complete the changes."
msgstr "Для применения изменений требуется перезагрузка системы."

#: client/pkgc-manage.c:161
msgid "You need to log out and back in to complete the changes."
msgstr "Для применения изменений нужно выйти из системы и войти снова."

#: client/pkgc-manage.c:167
msgid "Affected applications need to be restarted to complete the changes."
msgstr "Для применения изменений нужно перезапустить затронутые приложения."

#. TRANSLATORS: Description for pkgcli refresh
#: client/pkgc-manage.c:250
msgid "Refresh the package metadata cache."
msgstr "Обновить кэш метаданных пакетов."

#: client/pkgc-manage.c:276
msgid "Package metadata refreshed"
msgstr "Метаданные пакетов обновлены"

#. TRANSLATORS: Description for pkgcli install
#: client/pkgc-manage.c:301
msgid "Install one or more packages or local package files."
msgstr "Установить один или несколько пакетов или локальных файлов пакетов."

#. TRANSLATORS: There was an error finding a package
#. * for installation. The detailed error follows.
#. TRANSLATORS: We were unable to find a package for installation.
#: client/pkgc-manage.c:363 client/pkgc-manage.c:377
#, c-format
msgid "Could not find any available package: %s"
msgstr "Не удалось найти доступный пакет: %s"

#: client/pkgc-manage.c:382
msgid "The selected package is already installed."
msgstr "Выбранный пакет уже установлен."

#: client/pkgc-manage.c:438 client/pkgc-util.c:1702
#, c-format
msgid "Package not found: %s"
msgstr "Пакет не найден: %s"

#. TRANSLATORS: Description for pkgcli remove
#: client/pkgc-manage.c:479
msgid "Remove one or more packages from the system."
msgstr "Удалить один или несколько пакетов из системы."

#: client/pkgc-manage.c:500
#, c-format
msgid "Could not find installed packages: %s"
msgstr "Не удалось найти установленные пакеты: %s"

#. TRANSLATORS: Description for pkgcli download
#: client/pkgc-manage.c:542
msgid "Download packages to the specified directory without installing."
msgstr "Загрузить пакеты в указанный каталог без установки."

#. TRANSLATORS: There was an error getting the
#. * details about the package. The detailed error follows
#: client/pkgc-manage.c:555 client/pkgc-query.c:545 client/pkgc-query.c:889
#, c-format
msgid "Could not find packages: %s"
msgstr "Не удалось найти пакеты: %s"

#: client/pkgc-manage.c:563
#, c-format
msgid "Directory does not exist: %s"
msgstr "Каталог не существует: %s"

#. TRANSLATORS: Description for pkgcli update
#: client/pkgc-manage.c:607
msgid "Update all packages or specific packages to their latest versions."
msgstr "Обновить все пакеты или отдельные пакеты до последних версий."

#: client/pkgc-manage.c:630
#, c-format
msgid "Could not find packages to update: %s"
msgstr "Не удалось найти пакеты для обновления: %s"

#: client/pkgc-manage.c:660 client/pkgc-manage.c:934
#, c-format
msgid "Failed to get updates: %s"
msgstr "Не удалось получить обновления: %s"

#: client/pkgc-manage.c:672 client/pkgc-manage.c:942
msgid "No packages require updating"
msgstr "Ни один пакет не требует обновления"

#. TRANSLATORS: Description of pkgcli upgrade-os. Do not translate "list-os-upgrades"/"update"
#: client/pkgc-manage.c:708
msgid ""
"Upgrade the operating system to the release with the given upgrade ID.\n"
"The available upgrade IDs are shown by `list-os-upgrades`.\n"
"This command does not update packages within the current release, use `update` for that."
msgstr ""
"Обновить операционную систему до выпуска с указанным ID обновления.\n"
"Доступные ID обновлений показывает команда `list-os-upgrades`.\n"
"Эта команда не обновляет пакеты в рамках текущего выпуска — для этого используйте `update`."

#: client/pkgc-manage.c:750
#, c-format
msgid "Failed to read offline update action: %s"
msgstr "Не удалось прочитать действие автономного обновления: %s"

#: client/pkgc-manage.c:760
msgid "Offline update is not triggered."
msgstr "Автономное обновление не запущено."

#: client/pkgc-manage.c:769
#, c-format
msgid "Offline update is triggered. Action after update: %s"
msgstr "Автономное обновление запущено. Действие после обновления: %s"

#. TRANSLATORS: Packages that were prepared for an offline update
#: client/pkgc-manage.c:780
msgid "Prepared packages:"
msgstr "Подготовленные пакеты:"

#: client/pkgc-manage.c:794
msgid "No offline update is prepared."
msgstr "Автономное обновление не подготовлено."

#: client/pkgc-manage.c:797
#, c-format
msgid "Failed to read prepared offline updates: %s"
msgstr "Не удалось прочитать подготовленные автономные обновления: %s"

#: client/pkgc-manage.c:808
msgid "No results from last offline update available."
msgstr "Нет результатов последнего автономного обновления."

#: client/pkgc-manage.c:815
#, c-format
msgid "Last offline update failed: %s: %s"
msgstr "Последнее автономное обновление не удалось: %s: %s"

#: client/pkgc-manage.c:822
msgid "Last offline update completed successfully"
msgstr "Последнее автономное обновление успешно завершено"

#: client/pkgc-manage.c:832
#, c-format
msgid "Updated: %s"
msgstr "Обновлено: %s"

#: client/pkgc-manage.c:856
#, c-format
msgid "Failed to trigger offline update: %s"
msgstr "Не удалось запустить автономное обновление: %s"

#: client/pkgc-manage.c:860
msgid "Offline update scheduled. System will update on next reboot."
msgstr "Автономное обновление запланировано. Система обновится при следующей перезагрузке."

#. TRANSLATORS: Description of the pkgcli offline-update command.
#. * The request values (trigger, prepare, etc.) are parameters and MUST NOT be translated.
#: client/pkgc-manage.c:880
msgid ""
"Trigger & manage offline system updates.\n"
"\n"
"You can select one of these requests:\n"
"  prepare - prepare an offline update and trigger it (default)\n"
"  trigger - trigger a (manually prepared) offline update\n"
"  cancel  - cancel a planned offline update\n"
"  status  - show status information about a prepared or finished offline update"
msgstr ""
"Запустить и управлять автономными обновлениями системы.\n"
"\n"
"Вы можете выбрать один из следующих запросов:\n"
"  prepare — подготовить автономное обновление и запустить его (по умолчанию)\n"
"  trigger — запустить (подготовленное вручную) автономное обновление\n"
"  cancel  — отменить запланированное автономное обновление\n"
"  status  — показать информацию о состоянии подготовленного или завершённого автономного обновления"

#: client/pkgc-manage.c:902
#, c-format
msgid "Failed to cancel offline update: %s"
msgstr "Не удалось отменить автономное обновление: %s"

#: client/pkgc-manage.c:906
msgid "Offline update cancelled"
msgstr "Автономное обновление отменено"

#: client/pkgc-manage.c:963
#, c-format
msgid "Unknown offline-update request: %s"
msgstr "Неизвестный запрос автономного обновления: %s"

