#. SECURITY:
#. - Normal users are allowed to cancel their own task without
#. authentication, but a different user id needs the admin password
#. to cancel another users task.
#: data/policy/org.freedesktop.packagekit.policy.in:22
msgid "Cancel foreign task"
msgstr "Avbryt oppgåve som ein annan har starta"

#: data/policy/org.freedesktop.packagekit.policy.in:23
msgid "Authentication is required to cancel a task that was not started by yourself"
msgstr "Autentisering er nødvendig for å avbryte ei oppgåve som du ikkje har starta sjølv"

#. SECURITY:
#. - Normal users need authentication to install signed packages
#. from signed repositories, because otherwise the system is
#. only as secure as the least-secure package available in the
#. repositories.
#: data/policy/org.freedesktop.packagekit.policy.in:39
msgid "Install signed package"
msgstr "Installer signert pakke"

#: data/policy/org.freedesktop.packagekit.policy.in:40
msgid "Authentication is required to install software"
msgstr "Autentisering er nødvendig for å installere programvare"

#. SECURITY:
#. - Normal users require admin authentication to install untrusted or
#. unrecognised packages, as allowing users to do this without a
#. password would be a massive security hole.
#. - This is not retained as each package should be authenticated.
#: data/policy/org.freedesktop.packagekit.policy.in:56
msgid "Install untrusted local file"
msgstr "Installer lokal fil som ikkje er klarert"

#: data/policy/org.freedesktop.packagekit.policy.in:57
msgid "Authentication is required to install untrusted software"
msgstr "Autentisering er nødvendig for å installere programvare som ikkje er klarert"

#. SECURITY
#. - Normal users require admin authentication to reinstall packages.
#. - Authorization to install packages does not imply permissions to
#. reinstall them and vice versa.
#. - If a package in question is not trusted, user's permission to install
#. untrusted package will be checked as well.
#: data/policy/org.freedesktop.packagekit.policy.in:75
msgid "Install already installed package again"
msgstr "Installer ein pakke som alt er installert, på nytt"

#: data/policy/org.freedesktop.packagekit.policy.in:76
msgid "Authentication is required to reinstall software"
msgstr "Autentisering er nødvendig for å installere programvare på nytt"

#. SECURITY
#. - Normal users require admin authentication to downgrade packages.
#. - User authorized to downgrade signed packages is authorized to install
#. them as well.
#. - If a package in question is not trusted, user's permission to install
#. untrusted package will be checked as well.
#: data/policy/org.freedesktop.packagekit.policy.in:93
msgid "Install older version of installed package"
msgstr "Installer ein eldre versjon av ein installert pakke"

#: data/policy/org.freedesktop.packagekit.policy.in:94
msgid "Authentication is required to downgrade software"
msgstr "Autentisering er nødvendig for å nedgradere programvare"

#. SECURITY:
#. - Normal users require admin authentication to add signing keys.
#. - This implies adding an explicit trust, and should not be granted
#. without a secure authentication.
#. - This is not kept as each package should be authenticated.
#: data/policy/org.freedesktop.packagekit.policy.in:111
msgid "Trust a key used for signing software"
msgstr "Stol på ein nøkkel som vert brukt til å signere programvare"

#: data/policy/org.freedesktop.packagekit.policy.in:112
msgid "Authentication is required to consider a key used for signing software as trusted"
msgstr "Autentisering er nødvendig for å rekne ein nøkkel som vert brukt til å signere programvare, som klarert"

#. SECURITY:
#. - Normal users do not require admin authentication to accept new
#. licence agreements.
#. - Change this to 'auth_admin' for environments where users should not
#. be given the option to make legal decisions.
#: data/policy/org.freedesktop.packagekit.policy.in:128
msgid "Accept EULA"
msgstr "Godta lisensavtale (EULA)"

#: data/policy/org.freedesktop.packagekit.policy.in:129
msgid "Authentication is required to accept a EULA"
msgstr "Autentisering er nødvendig for å godta ein lisensavtale (EULA)"

#. SECURITY:
#. - Normal users require admin authentication to remove packages as
#. this can make the system unbootable or stop other applications from
#. working.
#. - Be sure to close the tool used to remove the packages after the
#. admin authentication has been obtained, otherwise packages can still
#. be removed. If this is not possible, change this authentication to
#. 'auth_admin'.
#. - This action is also required for any transaction that carries the
#. purge flag (e.g. UpdatePackages), as purging deletes the
#. configuration files and data of every package the transaction
#. removes.
#. TRANSLATORS: command description
#: data/policy/org.freedesktop.packagekit.policy.in:152 src/pk-direct.c:462
msgid "Remove package"
msgstr "Fjern pakke"

#: data/policy/org.freedesktop.packagekit.policy.in:153
msgid "Authentication is required to remove software"
msgstr "Autentisering er nødvendig for å fjerne programvare"

#. SECURITY:
#. - Normal users do not require admin authentication to update the
#. system as the packages will be signed, and the action is required
#. to update the system when unattended.
#. - Changing this to anything other than 'yes' will break unattended
#. updates.
#: data/policy/org.freedesktop.packagekit.policy.in:171
msgid "Update software"
msgstr "Oppdater programvare"

#: data/policy/org.freedesktop.packagekit.policy.in:172
msgid "Authentication is required to update software"
msgstr "Autentisering er nødvendig for å oppdatere programvare"

#. SECURITY:
#. - Normal users require admin authentication to enable or disable
#. software repositories as this can be used to enable new updates or
#. install different versions of software.
#: data/policy/org.freedesktop.packagekit.policy.in:187
msgid "Change software repository parameters"
msgstr "Endre parametrar for pakkekjelder"

#: data/policy/org.freedesktop.packagekit.policy.in:188
msgid "Authentication is required to change software repository parameters"
msgstr "Autentisering er nødvendig for å endre parametrar for pakkekjelder"

#. SECURITY:
#. - Normal users do not require admin authentication to refresh the
#. cache, as this doesn't actually install or remove software.
#: data/policy/org.freedesktop.packagekit.policy.in:202
msgid "Refresh system repositories"
msgstr "Oppdater systemet sine pakkekjelder"

#: data/policy/org.freedesktop.packagekit.policy.in:203
msgid "Authentication is required to refresh the system repositories"
msgstr "Autentisering er nødvendig for å oppdatere systemet sine pakkekjelder"

#. SECURITY:
#. - Normal users do not require admin authentication to set the proxy
#. used for downloading packages.
#: data/policy/org.freedesktop.packagekit.policy.in:217
msgid "Set network proxy"
msgstr "Set nettverksmellomtenar"

#: data/policy/org.freedesktop.packagekit.policy.in:218
msgid "Authentication is required to set the network proxy used for downloading software"
msgstr "Autentisering er nødvendig for å setje nettverksmellomtenaren som vert brukt til å laste ned programvare"

#. SECURITY:
#. - Normal users require admin authentication to upgrade the operating
#. system to a new release as this can make the system unbootable or
#. stop other applications from working.
#: data/policy/org.freedesktop.packagekit.policy.in:233
msgid "Upgrade the operating system"
msgstr "Oppgrader operativsystemet"

#: data/policy/org.freedesktop.packagekit.policy.in:234
msgid "Authentication is required to upgrade the operating system"
msgstr "Autentisering er nødvendig for å oppgradere operativsystemet"

#. SECURITY:
#. - Normal users require admin authentication to repair the system
#. since this can make the system unbootable or stop other
#. applications from working.
#: data/policy/org.freedesktop.packagekit.policy.in:249
msgid "Repair System"
msgstr "Reparer systemet"

#: data/policy/org.freedesktop.packagekit.policy.in:250
msgid "Authentication is required to repair the installed software"
msgstr "Autentisering er nødvendig for å reparere den installerte programvara"

#. SECURITY:
#. - Normal users are able to ask updates to be installed at
#. early boot time without a password.
#. SECURITY:
#. - Normal users require admin authentication to upgrade the system
#. to a new distribution since this can make the system unbootable or
#. stop other applications from working.
#: data/policy/org.freedesktop.packagekit.policy.in:264
#: data/policy/org.freedesktop.packagekit.policy.in:280
msgid "Trigger offline updates"
msgstr "Set i gang fråkopla oppdateringar"

#: data/policy/org.freedesktop.packagekit.policy.in:265
#: data/policy/org.freedesktop.packagekit.policy.in:281
msgid "Authentication is required to trigger offline updates"
msgstr "Autentisering er nødvendig for å setje i gang fråkopla oppdateringar"

#. SECURITY:
#. - Normal users are able to clear the updates message that is
#. shown after an updates are applied at boot time.
#: data/policy/org.freedesktop.packagekit.policy.in:295
msgid "Clear offline update message"
msgstr "Fjern meldinga om fråkopla oppdatering"

#: data/policy/org.freedesktop.packagekit.policy.in:296
msgid "Authentication is required to clear the offline updates message"
msgstr "Autentisering er nødvendig for å fjerne meldinga om fråkopla oppdateringar"

