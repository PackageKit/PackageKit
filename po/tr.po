msgstr "Paketleri kaldırırken kalan verileri (yapılandırma dosyaları, veri tabanları vb.) de kaldır"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:86
msgid "Maximum metadata cache age in seconds (default: 3 days)"
msgstr "Saniye türünden en büyük üst veri önbellek yaşı (öntanımlı: 3 gün)"

#: client/pkgc-manage.c:86
msgid "SECONDS"
msgstr "SANİYE"

#: client/pkgc-manage.c:156
msgid "A system restart is required to complete the changes."
msgstr "Değişikliklerin tamamlanması için sistemin yeniden başlatılması gerekiyor."

#: client/pkgc-manage.c:161
msgid "You need to log out and back in to complete the changes."
msgstr "Değişiklikleri tamamlamak için oturumunuzu kapatıp yeniden oturum açmanız gerekiyor."

#: client/pkgc-manage.c:167
msgid "Affected applications need to be restarted to complete the changes."
msgstr "Değişikliklerin tamamlanması için etkilenen uygulamaların yeniden başlatılması gerekiyor."

