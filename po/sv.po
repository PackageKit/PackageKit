msgstr "Inga paket behöver uppdateras"

#. TRANSLATORS: Description of pkgcli upgrade-os. Do not translate "list-os-upgrades"/"update"
#: client/pkgc-manage.c:708
msgid ""
"Upgrade the operating system to the release with the given upgrade ID.\n"
"The available upgrade IDs are shown by `list-os-upgrades`.\n"
"This command does not update packages within the current release, use `update` for that."
msgstr ""
"Uppgradera operativsystemet till utgåvan med givet uppgraderings-ID.\n"
"Tillgängliga uppgraderings-ID:n visas av `list-os-upgrades`.\n"
"Detta kommando uppdaterar inte paket inom aktuell utgåva, Använd `update` för det."

#: client/pkgc-manage.c:750
#, c-format
msgid "Failed to read offline update action: %s"
msgstr "Misslyckades med att läsa frånkopplad uppdateringsåtgärd: %s"

#: client/pkgc-manage.c:760
msgid "Offline update is not triggered."
msgstr "Frånkopplad uppdatering utlöses inte."

#: client/pkgc-manage.c:769
#, c-format
msgid "Offline update is triggered. Action after update: %s"
msgstr "Frånkopplad uppdatering utlöses. Åtgärd efter uppdatering: %s"

