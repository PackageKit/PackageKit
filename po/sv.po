msgid "No results from last offline update available."
msgstr "Inga resultat från senaste frånkopplad uppdatering tillgängliga."

#: client/pkgc-manage.c:815
#, c-format
msgid "Last offline update failed: %s: %s"
msgstr "Senaste frånkopplad uppdatering misslyckades: %s: %s"

#: client/pkgc-manage.c:822
msgid "Last offline update completed successfully"
msgstr "Senaste frånkopplad uppdatering lyckades"

#: client/pkgc-manage.c:832
#, c-format
msgid "Updated: %s"
msgstr "Uppdaterad: %s"

#: client/pkgc-manage.c:856
#, c-format
msgid "Failed to trigger offline update: %s"
msgstr "Misslyckades med att utlösa frånkopplad uppdatering: %s"

#: client/pkgc-manage.c:860
msgid "Offline update scheduled. System will update on next reboot."
msgstr "Frånkopplad uppdatering schemalagd. Systemet kommer uppdateras vid nästa omstart."

#. TRANSLATORS: Description of the pkgcli offline-update command.
#. * The request values (trigger, prepare, etc.) are parameters and MUST NOT be translated.
#: client/pkgc-manage.c:880
msgid ""
"Trigger & manage offline system updates.\n"
"\n"
"You can select one of these requests:\n"
"  prepare - prepare an offline update and trigger it (default)\n"
"  trigger - trigger a (manually prepared) offline update\n"
"  cancel  - cancel a planned offline update\n"
"  status  - show status information about a prepared or finished offline update"
msgstr ""
"Utlös & hantera frånkopplade systemuppdateringar.\n"
"\n"
"Du kan välja en av dessa förfrågningar:\n"
"  prepare - förbered en frånkopplad uppdatering och utlös den (standard)\n"
"  trigger - utlös en (manuellt förberedd) frånkopplad uppdatering\n"
"  cancel  - avbryt en planerad frånkopplad uppdatering\n"
"  status  - visa statusinformation om en förberedd eller slutförd frånkopplad uppdatering"

#: client/pkgc-manage.c:902
#, c-format
msgid "Failed to cancel offline update: %s"
msgstr "Misslyckades med att avbryta frånkopplad uppdatering: %s"

#: client/pkgc-manage.c:906
msgid "Offline update cancelled"
msgstr "Frånkopplad uppdatering avbröts"

#: client/pkgc-manage.c:963
#, c-format
msgid "Unknown offline-update request: %s"
msgstr "Okänd förfrågan för frånkopplad uppdatering: %s"

