#. TRANSLATORS: Description of the pkgcli offline-update command.
#. * The request values (trigger, prepare, etc.) are parameters and MUST NOT be translated.
#: client/pkgc-manage.c:945
msgid ""
"Trigger & manage offline system updates.\n"
"\n"
"You can select one of these requests:\n"
"  prepare - prepare an offline update and trigger it (default)\n"
"  trigger - trigger a (manually prepared) offline update\n"
"  cancel  - cancel a planned offline update\n"
"  status  - show status information about a prepared or finished offline update"
msgstr ""
"Iniciar e gerir atualizações do sistema offline.\n"
"\n"
"Pode selecionar uma das seguintes opções:\n"
"  prepare - preparar uma atualização offline e iniciá-la (opção predefinida)\n"
"  trigger - iniciar uma atualização offline (preparada manualmente)\n"
"  cancel  - cancelar uma atualização offline planeada\n"
"  status  - mostrar informações sobre o estado de uma atualização offline preparada ou concluída"

#: client/pkgc-manage.c:967
#, c-format
msgid "Failed to cancel offline update: %s"
msgstr "Falha ao cancelar atualização offline: %s"

#: client/pkgc-manage.c:971
msgid "Offline update cancelled"
msgstr "Atualização offline cancelada"

#: client/pkgc-manage.c:1028
#, c-format
msgid "Unknown offline-update request: %s"
msgstr "Solicitação de atualização offline desconhecida: %s"

