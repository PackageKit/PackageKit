msgstr "Nepodařilo se spustit offline aktualizaci: %s"

#: client/pkgc-manage.c:811
msgid "Offline update scheduled. System will update on next reboot."
msgstr "Offline aktualizace naplánována. Systém bude zaktualizován při příštím restartu."

#. TRANSLATORS: Description of the pkgcli offline-update command.
#. * The request values (trigger, prepare, etc.) are parameters and MUST NOT be translated.
#: client/pkgc-manage.c:831
msgid ""
"Trigger & manage offline system updates.\n"
"\n"
"You can select one of these requests:\n"
"  prepare - prepare an offline update and trigger it (default)\n"
"  trigger - trigger a (manually prepared) offline update\n"
"  cancel  - cancel a planned offline update\n"
"  status  - show status information about a prepared or finished offline update"
msgstr ""
"Spustit a spravovat offline aktualizace systému.\n"
"\n"
"Je možné vybrat jeden z těchto požadavků:\n"
"  prepare - připravit offline aktualizaci a spustit ji (výchozí)\n"
"  trigger - spustit (ručně připravenou) offline aktualizaci\n"
"  cancel  - zrušit naplánovanou offline aktualizaci\n"
"  status  - zobrazit stavovou informaci o připravené nebo dokončené offline aktualizaci"

#: client/pkgc-manage.c:853
#, c-format
msgid "Failed to cancel offline update: %s"
msgstr "Nepodařilo se zrušit offline aktualizaci: %s"

#: client/pkgc-manage.c:857
msgid "Offline update cancelled"
msgstr "Offline aktualizace zrušena"

#: client/pkgc-manage.c:914
#, c-format
msgid "Unknown offline-update request: %s"
msgstr "Neznámý požadavek na aktualizaci při odpojení: %s"

