#. TRANSLATORS: this is a percentage value we use in messages, e.g. "90%"
#: client/pk-offline-update.c:166
#, c-format
msgid "%i%%"
msgstr "%i%%"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing system upgrades
#: client/pk-offline-update.c:172
msgid "Installing System Upgrade"
msgstr "正在安裝系統升級"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing updates
#: client/pk-offline-update.c:176
msgid "Installing Updates"
msgstr "正在安裝更新"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:207
msgid "Rebooting after installing updates…"
msgstr "更新安裝完成，正重新開機…"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:246
msgid "Shutting down after installing updates…"
msgstr "在安裝完更新後關機…"

#. TRANSLATORS: we've started doing offline updates
#: client/pk-offline-update.c:392
msgid "Installing updates; this could take a while..."
msgstr "正在安裝更新；這會花上一段時間..."

#. TRANSLATORS: we've started doing offline system upgrade
#: client/pk-offline-update.c:430
msgid "Installing system upgrade; this could take a while..."
msgstr "正在安裝系統升級；這可能需要一段時間…"

#. TRANSLATORS: this is an atomic transaction
#. TRANSLATORS: the role is the point of the transaction,
#. * e.g. update-packages
#: client/pkcon/pk-console.c:173 client/pkcon/pk-console.c:603
msgid "Transaction"
msgstr "交易"

#. TRANSLATORS: this is the time the transaction was started in system timezone
#: client/pkcon/pk-console.c:175
msgid "System time"
msgstr "系統時間"

#: client/pkcon/pk-console.c:177 client/pkgc-util.c:1014
msgid "False"
msgstr "False"

#. TRANSLATORS: this is if the transaction succeeded or not
#: client/pkcon/pk-console.c:177
msgid "Succeeded"
msgstr "成功"

#: client/pkcon/pk-console.c:177 client/pkgc-util.c:1013
msgid "True"
msgstr "True"

#. TRANSLATORS: this is the transactions role, e.g. "update-packages"
#: client/pkcon/pk-console.c:179
msgid "Role"
msgstr "任務"

#: client/pkcon/pk-console.c:184
msgid "(seconds)"
msgstr "(秒)"

#. TRANSLATORS: this is The duration of the transaction
#: client/pkcon/pk-console.c:184
msgid "Duration"
msgstr "持續時間"

#. TRANSLATORS: this is The command line used to do the action
#: client/pkcon/pk-console.c:188
msgid "Command line"
msgstr "指令列"

#. TRANSLATORS: this is the user ID of the user that started the action
#: client/pkcon/pk-console.c:190
msgid "User ID"
msgstr "使用者 ID"

#. TRANSLATORS: this is the username, e.g. hughsie
#: client/pkcon/pk-console.c:197
msgid "Username"
msgstr "使用者名稱"

#. TRANSLATORS: this is the users real name, e.g. "Richard Hughes"
#: client/pkcon/pk-console.c:201
msgid "Real name"
msgstr "真實名稱"

#. TRANSLATORS: Label for affected packages in transaction
#. TRANSLATORS: these are packages touched by the transaction
#: client/pkcon/pk-console.c:209 client/pkgc-util.c:1064
#: client/pkgc-util.c:1082
msgid "Affected packages:"
msgstr "受影響的軟體包："

#. TRANSLATORS: these are packages touched by the transaction
#: client/pkcon/pk-console.c:212
msgid "Affected packages: None"
msgstr "受影響的軟體包：無"

#. TRANSLATORS: this is the distro, e.g. Fedora 10
#: client/pkcon/pk-console.c:234
msgid "Distribution"
msgstr "發行版本"

#. TRANSLATORS: this is type of update, stable or testing
#: client/pkcon/pk-console.c:236
msgid "Type"
msgstr "類型"

#. TRANSLATORS: this is any summary text describing the upgrade
#. TRANSLATORS: this is the summary of the group
#: client/pkcon/pk-console.c:238 client/pkcon/pk-console.c:276
msgid "Summary"
msgstr "摘要"

#. TRANSLATORS: this is the group category name
#: client/pkcon/pk-console.c:265
msgid "Category"
msgstr "分類"

#. TRANSLATORS: this is group identifier
#: client/pkcon/pk-console.c:267
msgid "ID"
msgstr "ID"

#. TRANSLATORS: this is the parent group
#: client/pkcon/pk-console.c:270
msgid "Parent"
msgstr "親代"

#. TRANSLATORS: this is the name of the parent group
#. TRANSLATORS: this is the name of the backend
#: client/pkcon/pk-console.c:273 client/pkcon/pk-console.c:2482
msgid "Name"
msgstr "名稱"

#. TRANSLATORS: this is preferred icon for the group
#: client/pkcon/pk-console.c:279
msgid "Icon"
msgstr "圖示"

#. TRANSLATORS: this is a header for the package that can be updated
#: client/pkcon/pk-console.c:329
msgid "Details about the update:"
msgstr "關於更新的詳細資訊："

#. TRANSLATORS: details about the update, package name and version
#. TRANSLATORS: the package that is being processed
#. TRANSLATORS: the package that is not signed by a known key
#. TRANSLATORS: the package name that was trying to be installed
#: client/pkcon/pk-console.c:335 client/pkcon/pk-console.c:620
#: lib/pk-task-text.c:115 lib/pk-task-text.c:186
msgid "Package"
msgstr "軟體包"

#. TRANSLATORS: details about the update, any packages that
#. * this update updates
#: client/pkcon/pk-console.c:340
msgid "Updates"
msgstr "更新"

#. TRANSLATORS: details about the update, any packages that
#. * this update obsoletes
#: client/pkcon/pk-console.c:347
msgid "Obsoletes"
msgstr "廢棄"

#. TRANSLATORS: details about the update, the vendor URLs
#. TRANSLATORS: the vendor (e.g. vmware) that is providing the EULA
#: client/pkcon/pk-console.c:353 lib/pk-task-text.c:189
msgid "Vendor"
msgstr "廠商"

#. TRANSLATORS: details about the update, the bugzilla URLs
#: client/pkcon/pk-console.c:359
msgid "Bugzilla"
msgstr "Bugzilla"

#. TRANSLATORS: details about the update, the CVE URLs
#: client/pkcon/pk-console.c:365
msgid "CVE"
msgstr "CVE"

#. TRANSLATORS: details about the update, if the package
#. * requires a restart
#: client/pkcon/pk-console.c:371
msgid "Restart"
msgstr "重新啟動"

#. TRANSLATORS: details about the update, any description of
#. * the update
#: client/pkcon/pk-console.c:376
msgid "Update text"
msgstr "更新文字"

#. TRANSLATORS: details about the update, the changelog for
#. * the package
#: client/pkcon/pk-console.c:381
msgid "Changes"
msgstr "變更"

#. TRANSLATORS: details about the update, the ongoing state
#. * of the update
#: client/pkcon/pk-console.c:386
msgid "State"
msgstr "狀態"

#. TRANSLATORS: details about the update, date the update
#. * was issued
#: client/pkcon/pk-console.c:391
msgid "Issued"
msgstr "已發布"

#. TRANSLATORS: details about the update, date the update
#. * was updated
#. TRANSLATORS: The action of the package, in past tense
#: client/pkcon/pk-console.c:396 lib/pk-enum.c:1111
msgid "Updated"
msgstr "已更新"

#. TRANSLATORS: if the repo is enabled
#: client/pkcon/pk-console.c:421
msgid "Enabled"
msgstr "已啟用"

#. TRANSLATORS: if the repo is disabled
#: client/pkcon/pk-console.c:424
msgid "Disabled"
msgstr "已停用"

#. TRANSLATORS: a package requires the system to be restarted
#: client/pkcon/pk-console.c:450
msgid "System restart required by:"
msgstr "以下原因需要重新啟動系統："

#. TRANSLATORS: a package requires the session to be restarted
#: client/pkcon/pk-console.c:453
msgid "Session restart required:"
msgstr "需要重新啟動工作階段："

#. TRANSLATORS: a package requires the system to be restarted
#. * due to a security update
#: client/pkcon/pk-console.c:457
msgid "System restart (security) required by:"
msgstr "以下原因需要重新啟動系統（安全）："

#. TRANSLATORS: a package requires the session to be restarted
#. * due to a security update
#: client/pkcon/pk-console.c:461
msgid "Session restart (security) required:"
msgstr "需要重新啟動工作階段（安全）："

#. TRANSLATORS: a package requires the application to be restarted
#: client/pkcon/pk-console.c:464
msgid "Application restart required by:"
msgstr "以下情況需要重新啟動應用程式："

#. TRANSLATORS: This a list of details about the package
#: client/pkcon/pk-console.c:517
msgid "Package description"
msgstr "軟體包描述"

#. TRANSLATORS: This where the package has no files
#: client/pkcon/pk-console.c:538
msgid "No files"
msgstr "無檔案"

#. TRANSLATORS: This a list files contained in the package
#: client/pkcon/pk-console.c:543
msgid "Package files"
msgstr "軟體包檔案"

#. TRANSLATORS: the percentage complete of the transaction
#: client/pkcon/pk-console.c:634
msgid "Percentage"
msgstr "百分比"

#. TRANSLATORS: the status of the transaction (e.g. downloading)
#: client/pkcon/pk-console.c:659
msgid "Status"
msgstr "狀態"

#. TRANSLATORS: the results from the transaction
#: client/pkcon/pk-console.c:696
msgid "Results:"
msgstr "結果："

#. TRANSLATORS: we failed to get any results, which is pretty
#. * fatal in my book
#: client/pkcon/pk-console.c:702 client/pkcon/pk-console.c:866
msgid "Fatal error"
msgstr "嚴重錯誤"

#. TRANSLATORS: the user asked to update everything,
#. * but there is nothing that can be updated
#: client/pkcon/pk-console.c:727
msgid "There are no packages to update."
msgstr "沒有軟體包需要更新。"

#. TRANSLATORS: the transaction failed in a way we could
#. * not expect
#. TRANSLATORS: the transaction failed in a way we could not expect
#: client/pkcon/pk-console.c:732
#: contrib/command-not-found/pk-command-not-found.c:701
msgid "The transaction failed"
msgstr "交易失敗"

#. TRANSLATORS: print a message when there are no updates
#: client/pkcon/pk-console.c:760
msgid "There are no updates available at this time."
msgstr "目前沒有任何更新。"

#: client/pkcon/pk-console.c:783
msgid "There are no upgrades available at this time."
msgstr "目前沒有可用的升級選項。"

#. TRANSLATORS: a package needs to restart their system
#: client/pkcon/pk-console.c:845
msgid "Please restart the computer to complete the update."
msgstr "請重新啟動電腦以完成更新。"

#. TRANSLATORS: a package needs to restart the session
#: client/pkcon/pk-console.c:848
msgid "Please logout and login to complete the update."
msgstr "請登出並再次登入來完成更新。"

#. TRANSLATORS: a package needs to restart their system (due to security)
#: client/pkcon/pk-console.c:853
msgid "Please restart the computer to complete the update as important security updates have been installed."
msgstr "由於已安裝重要的安全性更新，請重新啟動電腦以完成更新。"

#. TRANSLATORS: a package needs to restart the session (due to security)
#: client/pkcon/pk-console.c:857
msgid "Please logout and login to complete the update as important security updates have been installed."
msgstr "由於已安裝重要的安全性更新，請先登出並重新登入以完成更新。"

#. TRANSLATORS: more than one package could be found that matched,
#. * to follow is a list of possible packages
#: client/pkcon/pk-console.c:961 client/pkgc-util.c:1174
msgid "More than one package matches:"
msgstr "符合的軟體包不只一個："

#. prompt user for selection
#. TRANSLATORS: This finds out which package in the list to use
#: client/pkcon/pk-console.c:973 client/pkgc-util.c:1186
#, c-format
msgid "Please choose the correct package: "
msgstr "請選擇正確的軟體包： "

#. TRANSLATORS: we asked to install a package
#. * that could not be found in any repo
#: client/pkcon/pk-console.c:1008
msgid "Package not found"
msgstr "找不到軟體包"

#. TRANSLATORS: we couldn't find anything
#: client/pkcon/pk-console.c:1025
msgid "No packages were found"
msgstr "沒有找到軟體包"

#. TRANSLATORS: The user used
#. * 'pkcon install dave.rpm' rather than
#. * 'pkcon install-local dave.rpm'
#: client/pkcon/pk-console.c:1050
#, c-format
msgid "Expected package name, actually got file. Try using 'pkcon install-local %s' instead."
msgstr "預期的軟體包名稱，已實際取得檔案。嘗試使用 'pkcon install-local %s' 來替代。"

#. TRANSLATORS: There was an error finding a package
#. * for installation. The detailed error follows.
#: client/pkcon/pk-console.c:1087
#, c-format
msgid "This tool could not find any available package: %s"
msgstr "此工具無法找到任何可用的軟體包：%s"

#. TRANSLATORS: We were unable to find a package for installation.
#: client/pkcon/pk-console.c:1105
msgid "This tool could not find any available package."
msgstr "此工具沒有找到任何可用的軟體包。"

#. TRANSLATORS: There was an error finding a package
#. * for installation, it may already be installed.
#: client/pkcon/pk-console.c:1114
msgid "The selected packages may already be installed."
msgstr "所選的軟體包可能已安裝。"

#. TRANSLATORS: There was an error getting the list
#. * of files for the package. The detailed error follows
#: client/pkcon/pk-console.c:1148
#, c-format
msgid "This tool could not find the installed package: %s"
msgstr "此工具無法找到已安裝的軟體包：%s"

#. TRANSLATORS: There was an error getting the list
#. * of files for the package. The detailed error follows
#: client/pkcon/pk-console.c:1183 client/pkcon/pk-console.c:1215
#, c-format
msgid "This tool could not find the package: %s"
msgstr "此工具無法找到這個軟體包：%s"

#. TRANSLATORS: there are no updates, so nothing to do
#: client/pkcon/pk-console.c:1264
msgid "No packages require updating to newer versions."
msgstr "沒有任何軟體包需要更新至較新版本。"

#. TRANSLATORS: There was an error getting the list
#. * of files for the package. The detailed error follows
#. TRANSLATORS: There was an error getting the
#. * dependencies for the package. The detailed error follows
#. TRANSLATORS: There was an error getting the
#. * details about the package. The detailed error follows
#. TRANSLATORS: The package name was not found in
#. * any software repositories. The detailed error follows
#: client/pkcon/pk-console.c:1309 client/pkcon/pk-console.c:1340
#: client/pkcon/pk-console.c:1383 client/pkcon/pk-console.c:1450
#: client/pkcon/pk-console.c:1480
#, c-format
msgid "This tool could not find all the packages: %s"
msgstr "此工具無法找到所有軟體包：%s"

#. TRANSLATORS: This is when the daemon crashed, and we are up
#. * shit creek without a paddle
#: client/pkcon/pk-console.c:1507 client/pkgc-context.c:130
msgid "The daemon crashed mid-transaction!"
msgstr "常駐程式在交易過程中當機了！"

#. TRANSLATORS: This is the header to the --help menu
#: client/pkcon/pk-console.c:1539
msgid "PackageKit Console Interface"
msgstr "PackageKit 主控台介面"

#. these are commands we can use with pkcon
#: client/pkcon/pk-console.c:1541
msgid "Subcommands:"
msgstr "次指令："

#. TRANSLATORS: we keep a database updated with the time that an
#. * action was last executed
#: client/pkcon/pk-console.c:1642 client/pkgc-query.c:913
msgid "Failed to get the time since this action was last completed"
msgstr "無法取得自上次完成此操作以來的時間"

#. TRANSLATORS: this is the time since this role was used
#: client/pkcon/pk-console.c:1647
msgid "Time since"
msgstr "經過的時間"

#. TRANSLATORS: There follows a list of packages downloaded and ready
#. * to be updated
#: client/pkcon/pk-console.c:1667
msgid "Prepared updates:"
msgstr "預備更新："

#. TRANSLATORS: The network settings could not be sent
#: client/pkcon/pk-console.c:1737
msgid "The proxy could not be set"
msgstr "無法設定代理"

#. TRANSLATORS: command line argument, just show the version string
#: client/pkcon/pk-console.c:1780 client/pkcon/pk-monitor.c:354
msgid "Show the program version and exit"
msgstr "顯示程式版本然後離開"

#. TRANSLATORS: command line argument, use a filter to narrow down results
#: client/pkcon/pk-console.c:1783
msgid "Set the filter, e.g. installed"
msgstr "設定篩選條件，例如：已安裝"

#. command line argument, do we ask questions
#: client/pkcon/pk-console.c:1786
msgid "Install the packages without asking for confirmation"
msgstr "安裝軟體包時無需詢問確認"

#. TRANSLATORS: command line argument, do we just download or apply changes
#. command line argument, do we just download or apply changes
#: client/pkcon/pk-console.c:1789 client/pkgc-manage.c:43
msgid "Prepare the transaction by downloading packages only"
msgstr "僅下載軟體包以準備交易"

#. command line argument, do we allow package downgrades
#: client/pkcon/pk-console.c:1792
msgid "Allow packages to be downgraded during transaction"
msgstr "允許在交易過程中將軟體包降級"

#: client/pkcon/pk-console.c:1794
msgid "Allow packages to be reinstalled during transaction"
msgstr "允許在交易中重新安裝軟體包"

#: client/pkcon/pk-console.c:1796
msgid "Automatically remove unused dependencies"
msgstr "自動移除未使用的依賴項"

#. TRANSLATORS: command line argument, this command is not a priority
#: client/pkcon/pk-console.c:1799 client/pkgcli.c:98
msgid "Run the command using idle network bandwidth and also using less power"
msgstr "使用閒置的網路頻寬與較少的能源來執行指令"

#. TRANSLATORS: command line argument, just output without fancy formatting
#: client/pkcon/pk-console.c:1802
msgid "Print to screen a machine readable output, rather than using animated widgets"
msgstr "將機器可讀的輸出列印到畫面，而不是使用動畫化的小工具"

#. TRANSLATORS: command line argument, just output without fancy formatting
#: client/pkcon/pk-console.c:1805
msgid "The maximum metadata cache age (in seconds). Use -1 to use only cache, 1 to reload cache."
msgstr "中繼資料快取年歲上限（單位為秒）。使用 -1 來只用快取，1 來重新載入快取。"

#. command line argument, do we ask questions
#: client/pkcon/pk-console.c:1808
msgid "Allow untrusted packages to be installed."
msgstr "允許安裝未受信任的軟體包。"

#. TRANSLATORS: we failed to contact the daemon
#: client/pkcon/pk-console.c:1840
msgid "Failed to parse command line"
msgstr "無法解析指令列"

#. TRANSLATORS: we failed to contact the daemon
#: client/pkcon/pk-console.c:1850
msgid "Failed to contact PackageKit"
msgstr "無法聯絡 PackageKit"

#. TRANSLATORS: The user specified
#. * an incorrect filter
#: client/pkcon/pk-console.c:1921 client/pkgcli.c:261
msgid "The filter specified was invalid"
msgstr "指定的過濾條件無效"

#. TRANSLATORS: a search type can
#. * be name, details, file, etc
#: client/pkcon/pk-console.c:1947
msgid "A search type is required, e.g. name"
msgstr "必須選擇搜尋類型，例如：名稱"

#. TRANSLATORS: the user
#. * needs to provide a search term
#. TRANSLATORS: the user needs
#. * to provide a search term
#: client/pkcon/pk-console.c:1958 client/pkcon/pk-console.c:1978
#: client/pkcon/pk-console.c:1998 client/pkcon/pk-console.c:2018
msgid "A search term is required"
msgstr "必須輸入搜尋詞"

#. TRANSLATORS: the user did not
#. * specify what they wanted to install
#: client/pkcon/pk-console.c:2049
msgid "A package name to install is required"
msgstr "必須指定要安裝的軟體包名稱"

#. TRANSLATORS: the user did not
#. * specify what they wanted to install
#: client/pkcon/pk-console.c:2062
msgid "A filename to install is required"
msgstr "必須指定要安裝的檔案名稱"

#. TRANSLATORS: geeky error, real
#. * users won't see this
#: client/pkcon/pk-console.c:2081
msgid "A type, key_id and package_id are required"
msgstr "必須指定一個類型、key_id 以及 package_id"

#. TRANSLATORS: the user did not
#. * specify what they wanted to remove
#: client/pkcon/pk-console.c:2102
msgid "A package name to remove is required"
msgstr "必須指定要移除的軟體包名稱"

#. TRANSLATORS: the user did not
#. * specify anything about what to
#. * download or where
#: client/pkcon/pk-console.c:2116
msgid "A destination directory and the package names to download are required"
msgstr "必須指定目標目錄以及要下載的軟體包名稱"

#. TRANSLATORS: the directory does
#. * not exist, so we can't continue
#: client/pkcon/pk-console.c:2127
msgid "Directory not found"
msgstr "找不到目錄"

#. TRANSLATORS: geeky error, real
#. * users won't see this
#: client/pkcon/pk-console.c:2140
msgid "A licence identifier (eula-id) is required"
msgstr "必須指定授權識別碼 (eula-id)"

#. TRANSLATORS: The user did not
#. * specify a package name
#: client/pkcon/pk-console.c:2167
msgid "A package name to resolve is required"
msgstr "必須指定要解析的軟體包名稱"

#. TRANSLATORS: The user did not
#. * specify a repository name
#: client/pkcon/pk-console.c:2187 client/pkcon/pk-console.c:2207
msgid "A repository name is required"
msgstr "必須指定軟體庫名稱"

#. TRANSLATORS: The user didn't provide any data
#: client/pkcon/pk-console.c:2226
msgid "A repo name, parameter and value are required"
msgstr "必須指定一個軟體庫名稱、參數和值"

#. TRANSLATORS: The user didn't provide any data
#: client/pkcon/pk-console.c:2246
msgid "A repo id and autoremove required"
msgstr "必須指定軟體庫 id 與 autoremove"

#. TRANSLATORS: The user didn't specify what action to use
#. TRANSLATORS: The user didn't
#. * specify what action to use
#: client/pkcon/pk-console.c:2278 client/pkgc-query.c:963
msgid "An action, e.g. 'update-packages' is required"
msgstr "必須執行某項操作，例如「update-packages」"

#. TRANSLATORS: The user specified an invalid action
#. TRANSLATORS: The user specified
#. * an invalid action
#: client/pkcon/pk-console.c:2289 client/pkgc-query.c:971
msgid "A correct role is required"
