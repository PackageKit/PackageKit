msgstr "ერთი ან მეტი პაკეტის წაშლა სისტემიდან."

#: client/pkgc-manage.c:393
#, c-format
msgid "Could not find installed packages: %s"
msgstr "დაყენებული პაკეტების აღმოჩენა შეუძლებელია: %s"

