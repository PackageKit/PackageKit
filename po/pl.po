#. TRANSLATORS: this is a percentage value we use in messages, e.g. "90%"
#: client/pk-offline-update.c:165
#, c-format
msgid "%i%%"
msgstr "%i%%"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing system upgrades
#: client/pk-offline-update.c:171
msgid "Installing System Upgrade"
msgstr "Instalowanie aktualizacji systemu"

#. TRANSLATORS: this is the message we send plymouth to
#. * advise of the new percentage completion when installing updates
#: client/pk-offline-update.c:175
msgid "Installing Updates"
msgstr "Instalowanie aktualizacji"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:206
msgid "Rebooting after installing updates…"
msgstr "Ponowne uruchamianie komputera po zainstalowaniu aktualizacji…"

#. TRANSLATORS: we've finished doing offline updates
#: client/pk-offline-update.c:245
msgid "Shutting down after installing updates…"
msgstr "Wyłączanie komputera po zainstalowaniu aktualizacji…"

#. TRANSLATORS: we've started doing offline updates
#: client/pk-offline-update.c:391
msgid "Installing updates; this could take a while..."
msgstr "Instalowanie aktualizacji, może to chwilę zająć…"

#. TRANSLATORS: we've started doing offline system upgrade
#: client/pk-offline-update.c:429
msgid "Installing system upgrade; this could take a while..."
msgstr "Instalowanie aktualizacji systemu, może to chwilę zająć…"

#. TRANSLATORS: This is when the daemon crashed, and we are up
#. * shit creek without a paddle
#: client/pkgc-context.c:131
msgid "The daemon crashed mid-transaction!"
msgstr "Usługa uległa awarii w trakcie transakcji."

#. TRANSLATORS: command line argument, do we just download or apply changes
#: client/pkgc-manage.c:44
msgid "Prepare the transaction by downloading packages only"
msgstr "Przygotowuje transakcję, tylko pobierając pakiety"

#. TRANSLATORS: command line argument, do we allow package downgrades
#: client/pkgc-manage.c:51
msgid "Allow package downgrades"
msgstr "Zezwala na instalowanie starszych wersji pakietów"

#. TRANSLATORS: command line argument, do we allow package re-installations
#: client/pkgc-manage.c:58
msgid "Allow package re-installations"
msgstr "Zezwala na ponowne instalowanie pakietów"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:65
msgid "Allow installation of untrusted packages"
msgstr "Zezwala na instalowanie niezaufanych pakietów"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:72
msgid "Do not automatically remove unused dependencies"
msgstr "Nie usuwa automatycznie nieużywanych zależności"

#. TRANSLATORS: command line argument, remove configuration files too
#: client/pkgc-manage.c:79
msgid "Also remove residual data (config files, databases, etc.) when removing packages"
msgstr "Usuwa także pozostałe dane (pliki konfiguracyjne, bazy danych itp.) podczas usuwania pakietów"

#. TRANSLATORS: command line argument
#: client/pkgc-manage.c:86
msgid "Maximum metadata cache age in seconds (default: 3 days)"
msgstr "Maksymalny czas przechowywania metadanych w pamięci podręcznej w sekundach (domyślnie: 3 dni)"

#: client/pkgc-manage.c:86
msgid "SECONDS"
msgstr "SEKUNDY"

#: client/pkgc-manage.c:156
msgid "A system restart is required to complete the changes."
msgstr "Aby zakończyć wprowadzanie zmian, wymagane jest ponowne uruchomienie komputera."

#: client/pkgc-manage.c:161
msgid "You need to log out and back in to complete the changes."
msgstr "Aby zakończyć wprowadzanie zmian, należy wylogować się i zalogować ponownie."

#: client/pkgc-manage.c:167
msgid "Affected applications need to be restarted to complete the changes."
msgstr "Aby zakończyć wprowadzanie zmian, należy ponownie uruchomić aplikacje, których one dotyczą."

#. TRANSLATORS: Description for pkgcli refresh
#: client/pkgc-manage.c:256
msgid "Refresh the package metadata cache."
msgstr "Odświeża pamięć podręczną metadanych pakietów."

#: client/pkgc-manage.c:282
msgid "Package metadata refreshed"
msgstr "Odświeżono metadane pakietów"

#. TRANSLATORS: Description for pkgcli install
#: client/pkgc-manage.c:307
msgid "Install one or more packages or local package files."
msgstr "Instaluje podane pakiety lub lokalne pliki pakietów."

#. TRANSLATORS: There was an error finding a package
#. * for installation. The detailed error follows.
#. TRANSLATORS: We were unable to find a package for installation.
#: client/pkgc-manage.c:369 client/pkgc-manage.c:383
#, c-format
msgid "Could not find any available package: %s"
msgstr "Nie można odnaleźć żadnego dostępnego pakietu: %s"

#: client/pkgc-manage.c:388
msgid "The selected package is already installed."
msgstr "Wybrany pakiet jest już zainstalowany."

#: client/pkgc-manage.c:444 client/pkgc-util.c:1288
#, c-format
msgid "Package not found: %s"
msgstr "Nie odnaleziono pakietu: %s"

#. TRANSLATORS: Description for pkgcli remove
#: client/pkgc-manage.c:485
msgid "Remove one or more packages from the system."
msgstr "Usuwa podane pakiety z systemu."

#: client/pkgc-manage.c:506
#, c-format
msgid "Could not find installed packages: %s"
msgstr "Nie można odnaleźć zainstalowanych pakietów: %s"

#. TRANSLATORS: Description for pkgcli download
#: client/pkgc-manage.c:548
msgid "Download packages to the specified directory without installing."
msgstr "Pobiera pakiety do podanego katalogu bez instalowania ich."

#. TRANSLATORS: There was an error getting the
#. * details about the package. The detailed error follows
#: client/pkgc-manage.c:561 client/pkgc-query.c:450 client/pkgc-query.c:797
#, c-format
msgid "Could not find packages: %s"
msgstr "Nie można odnaleźć pakietów: %s"

#: client/pkgc-manage.c:569
#, c-format
msgid "Directory does not exist: %s"
msgstr "Katalog nie istnieje: %s"

#. TRANSLATORS: Description for pkgcli update
#: client/pkgc-manage.c:613
msgid "Update all packages or specific packages to their latest versions."
msgstr "Aktualizuje wszystkie lub wybrane pakiety do najnowszych wersji."

#: client/pkgc-manage.c:636
#, c-format
msgid "Could not find packages to update: %s"
msgstr "Nie można odnaleźć pakietów do zaktualizowania: %s"

#: client/pkgc-manage.c:666 client/pkgc-manage.c:767 client/pkgc-manage.c:999
#, c-format
msgid "Failed to get updates: %s"
msgstr "Uzyskanie aktualizacji się nie powiodło: %s"

#: client/pkgc-manage.c:678 client/pkgc-manage.c:778 client/pkgc-manage.c:1007
msgid "No packages require updating"
msgstr "Żadne pakiety nie wymagają aktualizacji"

#. TRANSLATORS: Description of pkgcli upgrade.
#. * No not translate "minimal, default, complete", those are parameters
#: client/pkgc-manage.c:718
msgid ""
"Upgrade all packages or perform a distribution upgrade.\n"
"\n"
"Types: minimal, default, complete"
msgstr ""
"Aktualizuje wszystkie pakiety lub przeprowadza aktualizację dystrybucji do nowszej wersji.\n"
"\n"
"Typy: minimal, default, complete"

#: client/pkgc-manage.c:815
#, c-format
msgid "Failed to read offline update action: %s"
msgstr "Odczytanie działania aktualizacji w trybie offline się nie powiodło: %s"

#: client/pkgc-manage.c:825
msgid "Offline update is not triggered."
msgstr "Aktualizacja w trybie offline nie jest włączona."

#: client/pkgc-manage.c:834
#, c-format
msgid "Offline update is triggered. Action after update: %s"
msgstr "Aktualizacja w trybie offline jest włączona. Działanie po aktualizacji: %s"

#. TRANSLATORS: Packages that were prepared for an offline update
#: client/pkgc-manage.c:845
msgid "Prepared packages:"
msgstr "Przygotowane pakiety:"

#: client/pkgc-manage.c:859
msgid "No offline update is prepared."
msgstr "Nie przygotowano żadnej aktualizacji w trybie offline."

#: client/pkgc-manage.c:862
#, c-format
msgid "Failed to read prepared offline updates: %s"
msgstr "Odczytanie przygotowanych aktualizacji w trybie offline się nie powiodło: %s"

#: client/pkgc-manage.c:873
msgid "No results from last offline update available."
msgstr "Brak dostępnych wyników ostatniej aktualizacji w trybie offline."

#: client/pkgc-manage.c:880
#, c-format
msgid "Last offline update failed: %s: %s"
msgstr "Ostatnia aktualizacja w trybie offline się nie powiodła: %s: %s"

#: client/pkgc-manage.c:887
msgid "Last offline update completed successfully"
msgstr "Ostatnia aktualizacja w trybie offline została ukończona"

#: client/pkgc-manage.c:897
#, c-format
msgid "Updated: %s"
msgstr "Zaktualizowano: %s"

#: client/pkgc-manage.c:921
#, c-format
msgid "Failed to trigger offline update: %s"
msgstr "Włączenie aktualizacji w trybie offline się nie powiodło: %s"

#: client/pkgc-manage.c:925
msgid "Offline update scheduled. System will update on next reboot."
msgstr "Zaplanowano aktualizację w trybie offline. System zostanie zaktualizowany podczas następnego ponownego uruchomienia."

#. TRANSLATORS: Description of the pkgcli offline-update command.
#. * The request values (trigger, prepare, etc.) are parameters and MUST NOT be translated.
#: client/pkgc-manage.c:945
msgid ""
"Trigger & manage offline system updates.\n"
"\n"
"You can select one of these requests:\n"
"  prepare - prepare an offline update and trigger it (default)\n"
"  trigger - trigger a (manually prepared) offline update\n"
"  cancel  - cancel a planned offline update\n"
"  status  - show status information about a prepared or finished offline update"
msgstr ""
"Włącza aktualizacje systemu w trybie offline i zarządza nimi.\n"
"\n"
"Można wybrać jedno z tych żądań:\n"
"  prepare - przygotowuje aktualizację w trybie offline i ją włącza (domyślnie)\n"
"  trigger - włącza (ręcznie przygotowaną) aktualizację w trybie offline\n"
"  cancel  - anuluje zaplanowaną aktualizację w trybie offline\n"
"  status  - wyświetla informacje o stanie przygotowanej lub ukończonej aktualizacji w trybie offline"

#: client/pkgc-manage.c:967
#, c-format
msgid "Failed to cancel offline update: %s"
msgstr "Anulowanie aktualizacji w trybie offline się nie powiodło: %s"

#: client/pkgc-manage.c:971
msgid "Offline update cancelled"
msgstr "Anulowano aktualizację w trybie offline"

#: client/pkgc-manage.c:1028
#, c-format
msgid "Unknown offline-update request: %s"
msgstr "Nieznane żądanie aktualizacji w trybie offline: %s"

