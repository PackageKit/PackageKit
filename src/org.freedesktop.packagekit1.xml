<!DOCTYPE node PUBLIC
"-//freedesktop//DTD D-BUS Object Introspection 1.0//EN"
"http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd" [
  <!ENTITY ERROR_GENERAL "org.freedesktop.packagekit1.Denied">
]>
<node name="/">
  <!--
    org.freedesktop.packagekit1:

    The root interface is used for interacting with the daemon.
  -->
  <interface name="org.freedesktop.packagekit1">

    <!--*********************************************************************-->
    <!--
      VersionMajor:

      The major version number.
    -->
    <property name="VersionMajor" type="u" access="read"/>
    <!--
      VersionMinor:

      The minor version number.
    -->
    <property name="VersionMinor" type="u" access="read"/>
    <!--
      VersionMicro:

      The micro version number.
    -->
    <property name="VersionMicro" type="u" access="read"/>

    <!--*********************************************************************-->
    <!--
      BackendName:

      The backend name, e.g. `"dnf"`.
    -->
    <property name="BackendName" type="s" access="read"/>

    <!--*********************************************************************-->
    <!--
      BackendDescription:

      The backend description, e.g. `"Yellow Dog Update Modifier"`.
    -->
    <property name="BackendDescription" type="s" access="read"/>

    <!--*********************************************************************-->
    <!--
      BackendAuthor:

      The backend author, e.g. `"Joe Bloggs <joe&blogs.com>"`.
    -->
    <property name="BackendAuthor" type="s" access="read"/>

    <!--*********************************************************************-->
    <!--
      Roles:

      The roles the backend supports, e.g. `search-name|refresh-cache`.
    -->
    <property name="Roles" type="t" access="read"/>

    <!--*********************************************************************-->
    <!--
      Groups:

      The groups the backend supports, e.g. `accessories|games`.
    -->
    <property name="Groups" type="t" access="read"/>

    <!--*********************************************************************-->
    <!--
      Filters:

      The filters the backend supports, e.g. `installed|newest`.
    -->
    <property name="Filters" type="t" access="read"/>

    <!--*********************************************************************-->
    <!--
      MimeTypes:

      The mime-types the backend supports, e.g. `['application/x-rpm;',
      'application/x-deb']`.
    -->
    <property name="MimeTypes" type="as" access="read"/>

    <!--*********************************************************************-->
    <!--
      Locked:

      Set when the backend is locked and native tools would fail.
    -->
    <property name="Locked" type="b" access="read"/>

    <!--*********************************************************************-->
    <!--
      NetworkState:

      Gets the network state from the daemon. This is provided as some clients
      may not want to use NetworkManager if the system daemon is configured to
      use something else.

      If the system is managed using NetworkManager then the following states
      are supported: `unknown`, `offline`, `online`, `wifi`, `mobile` or
      `wired`. If the system is configured for legacy UNIX network fallback,
      or NetworkManager is not running then the folowing states are supported:
      `unknown`, `offline` or `online`.
    -->
    <property name="NetworkState" type="u" access="read"/>

    <!--*********************************************************************-->
    <!--
      DistroId:

      The distribution identification, in the distro;version;arch form e.g.
      `"debian;squeeze/sid;x86_64"`.
    -->
    <property name="DistroId" type="s" access="read"/>

    <!--*********************************************************************-->
    <!--
      CanAuthorize:
      @action_id: The action ID, e.g. `org.freedesktop.packagekit.system-network-proxy-configure`

      Allows a client to find out if it would be allowed to authorize an
      action.

      Returns:

      - `result`: The result, either `yes`, `no` or `interactive`.
    -->
    <method name="CanAuthorize">
      <annotation name="org.freedesktop.DBus.GLib.Async" value=""/>
      <arg type="s" name="action_id" direction="in"/>
      <arg type="u" name="result" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      CreateTransaction:

      Creates a new transaction that can have operations done on it. Note: The
      dameon will automatically destroy this transaction if it is not used
      after a few minutes.

      Returns:

      - `object_path`: The object_path, e.g. `/45_dafeca`
    -->
    <method name="CreateTransaction">
      <annotation name="org.freedesktop.DBus.GLib.Async" value=""/>
      <arg type="o" name="object_path" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      GetTimeSinceAction:
      @role: The role enum, e.g. `update-system`

      This method allows us to query how long since an action has successfully
      completed.

      Returns:

      - `seconds`: The amount of time in seconds
    -->
    <method name="GetTimeSinceAction">
      <arg type="u" name="role" direction="in"/>
      <arg type="u" name="seconds" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      GetTransactionList:

      Gets the transaction list of any transactions that are in progress

      Returns:

      - `transactions`: A list of transaction ID's
    -->
    <method name="GetTransactionList">
      <arg type="ao" name="transactions" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      StateHasChanged:
      @reason: The reason of the state change. Valid reasons are `resume` or `posttrans`. Resume is given a lower priority than posttrans.

      This method suggests to PackageKit that the package backend state may
      have changed. This allows plugins to the native package manager to
      suggest that PackageKit drops it's caches.
    -->
    <method name="StateHasChanged">
      <arg type="s" name="reason" direction="in"/>
    </method>

    <!--*********************************************************************-->
    <!--
      SuggestDaemonQuit:

      Suggests to the daemon that it should quit as soon as possible, for
      instance if a native package management tool is waiting to be used.
    -->
    <method name="SuggestDaemonQuit"/>

    <!--*********************************************************************-->
    <!--
      GetPackageHistory:
      @names: The package names to return history for, e.g. `[ colord ]`.
      @count: The maximum number of past transactions to return, or 0 for no limit.

      Gets the history for a given package name. This uses the internal
      PackageKit history database and will not return transactions done
      outside of PackageKit using a distribution native tool.

      Returns:

      - `history`: The list of actions performed on this package. The array
        may contain the following keys of types: `info[uint]`,
        `user-id[uint]`, `version[string]`, `source[string]`,
        `timestamp[uint64]`. Other keys and values may be added in the future.
    -->
    <method name="GetPackageHistory">
      <annotation name="org.qtproject.QtDBus.QtTypeName.Out0" value="QVariant"/>
      <arg type="as" name="names" direction="in"/>
      <arg type="u" name="count" direction="in"/>
      <arg type="a{saa{sv}}" name="history" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      GetDaemonState:

      Gets the debugging state from the daemon. No secure state will be shown,
      and all information is for reference only.

      Returns:

      - `state`: The state of the dameon at this specific moment.
    -->
    <method name="GetDaemonState">
      <arg type="s" name="state" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      SetProxy:
      @proxy_http: The HTTP proxy, e.g. `username:password@server:port`.
      @proxy_https: The HTTPS proxy, e.g. `username:password@server:port`.
      @proxy_ftp: The FTP proxy, e.g. `username:password@server:port`.
      @proxy_socks: The SOCKS proxy, e.g. `username:password@server:port`.
      @no_proxy: The comma seporated list of sites to not use the proxy for, e.g. `127.0.0.1,localmirror.org`.
      @pac: The PAC file for the proxy, e.g. `/etc/network/school.pac`. Note: Most backends will not be able to use a PAC file.

      Sets the proxy used by the dameon.

      Callers need the org.freedesktop.packagekit.set-proxy permission.
    -->
    <method name="SetProxy">
      <annotation name="org.freedesktop.DBus.GLib.Async" value=""/>
      <arg type="s" name="proxy_http" direction="in"/>
      <arg type="s" name="proxy_https" direction="in"/>
      <arg type="s" name="proxy_ftp" direction="in"/>
      <arg type="s" name="proxy_socks" direction="in"/>
      <arg type="s" name="no_proxy" direction="in"/>
      <arg type="s" name="pac" direction="in"/>
    </method>

    <!--*********************************************************************-->
    <!--
      TransactionListChanged:
      @transactions: A list of transaction ID's.

      The transaction list has changed, because either a transaction has
      finished or a new transaction created.
    -->
    <signal name="TransactionListChanged">
      <arg type="as" name="transactions" direction="out"/>
    </signal>

    <!--*********************************************************************-->
    <!--
      RestartSchedule:

      A system restart has been sceduled
    -->
    <signal name="RestartSchedule"/>

    <!--*********************************************************************-->
    <!--
      InstalledChanged:

      This signal is emitted when the set of installed apps has potentially
      changed.
    -->
    <signal name="InstalledChanged"/>

    <!--*********************************************************************-->
    <!--
      RepoListChanged:

      This signal is emitted when the repository list has changed
    -->
    <signal name="RepoListChanged"/>

    <!--*********************************************************************-->
    <!--
      UpdatesChanged:

      This signal is emitted when the number of updates has changed
    -->
    <signal name="UpdatesChanged"/>

  </interface>

  <!--*********************************************************************-->
  <!--
    org.freedesktop.packagekit1.Offline:

    The interface used for interacting with offline actions.
  -->
  <interface name="org.freedesktop.packagekit1.Offline">

    <!--*********************************************************************-->
    <!--
      UpdatePrepared:

      If an update has been prepared and is ready to be triggered.
    -->
    <property name="UpdatePrepared" type="b" access="read"/>

    <!--*********************************************************************-->
    <!--
      UpdateTriggered:

      If an update has been triggered.
    -->
    <property name="UpdateTriggered" type="b" access="read"/>

    <!--*********************************************************************-->
    <!--
      UpgradePrepared:

      If a system upgrade has been prepared and is ready to be triggered.
    -->
    <property name="UpgradePrepared" type="b" access="read"/>

    <!--*********************************************************************-->
    <!--
      UpgradeTriggered:

      If a system upgrade has been triggered.
    -->
    <property name="UpgradeTriggered" type="b" access="read"/>

    <!--*********************************************************************-->
    <!--
      PreparedUpgrade:

      Details about a prepared system upgrade. Currently recognized keys are
      `"name"` and `"version"`.
    -->
    <property name="PreparedUpgrade" type="a{sv}" access="read">
      <annotation name="org.qtproject.QtDBus.QtTypeName" value="QVariantMap"/>
    </property>

    <!--*********************************************************************-->
    <!--
      TriggerAction:

      The action to take when finished applying updates, known values are
      `power-off`, `reboot` or `unset` if no offline update is scheduled.
    -->
    <property name="TriggerAction" type="s" access="read"/>

    <!--*********************************************************************-->
    <!--
      GetResults:

      If the last offline action was completed successfully, returns a list of
      packages that were processed, a type of the action done and the unix
      timestamp when the action was finished. Otherwise returns an error code
      and error description.

      Returns:

      - `success`: A boolean value representing success.
      - `package_ids`: An array of package IDs.
      - `role`: The role enum, e.g. `update-system`
      - `time_finished`: The unix timestamp when the operation was completed.
      - `error_code`: A PackageKit error code. The value of this argument is
        undefined if the "success" argument returned true.
      - `error_description`: A detailed error description. The value of this
        argument is undefined if the "success" argument returned true.
    -->
    <method name="GetResults">
      <arg type="b" name="success" direction="out"/>
      <arg type="as" name="package_ids" direction="out"/>
      <arg type="u" name="role" direction="out"/>
      <arg type="t" name="time_finished" direction="out"/>
      <arg type="u" name="error_code" direction="out"/>
      <arg type="s" name="error_description" direction="out"/>
    </method>

    <!--*********************************************************************-->
    <!--
      ClearResults:

      Clears the offline update results store.
    -->
    <method name="ClearResults"/>

    <!--*********************************************************************-->
    <!--
      Trigger:
      @action: The action to take when finished applying updates, known values are `power-off` and `reboot`.

      Triggers the offline update for next boot.

      If the update is already triggered, only the action is changed, which
      requires no authorization. If a system upgrade is triggered instead, it
      is replaced by the update, which requires the same authorization as
      triggering a system upgrade.
    -->
    <method name="Trigger">
      <arg type="s" name="action" direction="in"/>
    </method>

    <!--*********************************************************************-->
    <!--
      TriggerUpgrade:
      @action: The action to take when finished installing the system upgrade, known values are `power-off` and `reboot`.

      Triggers the offline system upgrade for next boot.

      If the system upgrade is already triggered, only the action is changed,
      which requires no authorization. If an offline update is triggered
      instead, it is replaced by the system upgrade.
    -->
    <method name="TriggerUpgrade">
      <arg type="s" name="action" direction="in"/>
    </method>

    <!--*********************************************************************-->
    <!--
      Cancel:

      Cancels the offline update so the next boot procceeds as normal.

      Removing a triggered system upgrade requires the same authorization as
      triggering it did.
    -->
    <method name="Cancel"/>

    <!--*********************************************************************-->
    <!--
      GetPrepared:

      Returns the list of prepared updates.

      Returns:

      - `package_ids`: An array of package IDs.
    -->
    <method name="GetPrepared">
      <arg type="as" name="package_ids" direction="out"/>
    </method>

  </interface>

</node>
