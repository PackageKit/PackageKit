[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Operation = Remove
Target = *

[Action]
Description = Refreshing PackageKit...
When = PostTransaction
Exec = /bin/sh -c 'gdbus call --system --timeout 30 --dest org.freedesktop.packagekit1 --object-path /org/freedesktop/packagekit1 --method org.freedesktop.packagekit1.StateHasChanged posttrans > /dev/null'
